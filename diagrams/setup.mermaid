    %% =========================================================================
    %% FILE I/O CONNECTIONS
    %% =========================================================================

    %% --- ctf-env-functions.sh: script body -----------------------------------
    ctf-env-functions.sh --|READ|--> F_CTF_ENV_MODE
    ctf-env-functions.sh --|READ|--> F_CTF_ENV

    %% --- _ctf_persist(): atomic rewrite of ~/.ctf_env via tmp ---------------
    EF_H5 --|READ|--> F_CTF_ENV
    EF_H5 --|WRITE|--> F_CTF_ENV

    %% --- _ctf_write_box_env(): writes BOX_DIR/.env --------------------------
    EF_H6 --|WRITE|--> F_BOX_ENV

    %% --- set-env(): writes ~/.ctf_env_mode, then re-sources ~/.ctf_env ------
    EF_P2 --|WRITE|--> F_CTF_ENV_MODE
    EF_P2 --|READ|--> F_CTF_ENV

    %% --- ctf-status(): reads ~/.ctf_env_mode existence for display ----------
    EF_P5 --|READ|--> F_CTF_ENV_MODE

    %% --- set-box(): writes BOX_DIR/notes/notes.md ---------------------------
    EF_P4 --|WRITE|--> F_BOX_NOTES

    %% --- ctf-help(): reads ~/.ctf_env_mode existence for display ------------
    EF_P7 --|READ|--> F_CTF_ENV_MODE

    %% --- ctf-install.sh: script body reads ctf-env-functions.sh for KNOWN_PLATFORMS
    ctf-install.sh --|READ|--> F_EF_SRC

    %% --- run_backup(): reads ~/.ctf_env, writes timestamped backup ----------
    IN_F3 --|READ|--> F_CTF_ENV
    IN_F3 --|WRITE|--> F_CTF_ENV_BACKUP

    %% --- run_deploy_env(): reads ctf-env-functions.sh, writes ~/.ctf_env ----
    IN_F5 --|READ|--> F_EF_SRC
    IN_F5 --|WRITE|--> F_CTF_ENV

    %% --- run_patch_zshrc(): reads ~/.zshrc, appends source line -------------
    IN_F6 --|READ|--> F_ZSHRC
    IN_F6 --|WRITE|--> F_ZSHRC

    %% --- run_symlinks(): reads setup/*.sh, writes symlinks ------------------
    IN_F8 --|READ|--> F_EF_SRC
    IN_F8 --|WRITE|--> F_SYMLINK

    %% --- ctf-sync.sh: git clone/pull from GitHub ----------------------------
    F_GITHUB --|READ|--> ctf-sync.sh
    ctf-sync.sh --|WRITE|--> F_GITHUB

    %% --- ctf-sync.sh: deploy step -------------------------------------------
    ctf-sync.sh --|READ|--> F_EF_SRC
    ctf-sync.sh --|WRITE|--> F_CTF_ENV

    %% =========================================================================
    %% DATAFLOW — ctf-env-functions.sh
    %% =========================================================================

    %% --- User resolution: OS env → _CTF_HOME, REAL_USER ---------------------
    %% sudo path: SUDO_USER → getent → _CTF_HOME; SUDO_USER → REAL_USER
    ENV_SUDO_USER --> EF_SV1
    ENV_SUDO_USER --> EF_SV2
    %% normal path: $HOME → _CTF_HOME; $USER → REAL_USER
    ENV_HOME --> EF_SV1
    ENV_USER --> EF_SV2

    %% --- CTF_REPO_DIR resolution at startup ---------------------------------
    %% Path 1: ~/.ctf_env_mode sourced → sets CTF_REPO_DIR
    F_CTF_ENV_MODE -. source .-> EF_SV3
    %% Path 2: _CTF_HOME used to construct dev path
    EF_SV1 --> EF_SV3
    %% Env override: pre-exported CTF_REPO_DIR skips all detection
    ENV_CTF_REPO_DIR -. override .-> EF_SV3

    %% --- CTF_BASE resolution -------------------------------------------------
    ENV_CTF_BASE_DIR -. override .-> EF_SV4

    %% --- set-address(): arg → new_ip → octets[] → ADDRESS -------------------
    EF_A1 --> EF_P1_V1
    EF_P1_V1 --> EF_P1_V2
    EF_P1_V1 --> EF_P1_V3
    EF_SV7 --> EF_P1_V3
    EF_P1_V1 --> EF_SV7

    %% --- set-env(): arg → mode → target_path → CTF_REPO_DIR + mode file ----
    EF_A2 --> EF_P2_V1
    EF_SV1 --> EF_P2_V2
    EF_P2_V1 --> EF_P2_V4
    EF_P2_V2 --> EF_P2_V4
    EF_P2_V3 --> EF_P2_V4
    EF_P2_V4 --> EF_SV3
    EF_SV3 --> EF_P2_V5

    %% --- set-platform(): arg → new_platform → PLATFORM, pdir, BOX_DIR ------
    EF_A3 --> EF_P3_V1
    EF_SV6 --> EF_P3_V2
    EF_SV6 --> EF_P3_V3
    EF_P3_V1 --> EF_SV8
    EF_P3_V1 --> EF_P3_V7
    EF_SV4 --> EF_P3_V7
    EF_SV8 --> EF_P3_V4
    EF_P3_V1 --> EF_P3_V5
    EF_SV8 --> EF_P3_V6
    %% PLATFORM + BOXNAME + CTF_BASE → BOX_DIR (when BOXNAME already set)
    EF_SV8 --> EF_SV10
    EF_SV9 --> EF_SV10
    EF_SV4 --> EF_SV10

    %% --- set-box(): arg → new_box → BOXNAME → BOX_DIR -----------------------
    EF_A4 --> EF_P4_V1
    EF_P4_V1 --> EF_SV9
    EF_SV9 --> EF_P4_V2
    EF_SV4 --> EF_SV10
    EF_SV4 --> EF_P4_V3

