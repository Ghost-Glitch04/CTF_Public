---
title: Production Setup
---
flowchart TD
    %% =========================================================================
    %% NODE DEFINITIONS
    %% =========================================================================

    %% --- Flags: ctf-install.sh -----------------------------------------------
    IN_A1@{ shape: flag, label: "--prod" }
    IN_A2@{ shape: flag, label: "--check" }
    IN_A3@{ shape: flag, label: "--yes / -y" }
    IN_A4@{ shape: flag, label: "--help / -h" }

    %% --- Flags: ctf-sync.sh --------------------------------------------------
    SY_A1@{ shape: flag, label: "--prod" }
    SY_A2@{ shape: flag, label: "--help / -h" }

    %% --- Arguments: ctf-env-functions.sh public commands ---------------------
    EF_A1@{ shape: flag, label: "<ip_address>" }
    EF_A2@{ shape: flag, label: "<dev|prod>" }
    EF_A3@{ shape: flag, label: "<platform_code>" }
    EF_A4@{ shape: flag, label: "<box_name>" }

    %% --- Functions: ctf-env-functions.sh (Private Helpers) ------------------
    EF_H1@{ shape: lin-rect, label: "_ctf_ok()" }
    EF_H2@{ shape: lin-rect, label: "_ctf_warn()" }
    EF_H3@{ shape: lin-rect, label: "_ctf_err()" }
    EF_H4@{ shape: lin-rect, label: "_ctf_info()" }
    EF_H5@{ shape: lin-rect, label: "_ctf_persist()" }
    EF_H6@{ shape: lin-rect, label: "_ctf_write_box_env()" }
    EF_H7@{ shape: lin-rect, label: "_ctf_lookup_platform_name()" }

    %% --- Functions: ctf-env-functions.sh (Public Commands) ------------------
    EF_P1@{ shape: lin-rect, label: "set-address()" }
    EF_P2@{ shape: lin-rect, label: "set-env()" }
    EF_P3@{ shape: lin-rect, label: "set-platform()" }
    EF_P4@{ shape: lin-rect, label: "set-box()" }
    EF_P5@{ shape: lin-rect, label: "ctf-status()" }
    EF_P6@{ shape: lin-rect, label: "ctf-clear()" }
    EF_P7@{ shape: lin-rect, label: "ctf-help()" }

    %% --- Script-level variables: ctf-env-functions.sh -----------------------
    EF_SV1@{ shape: bow-rect, label: "_CTF_HOME" }
    EF_SV2@{ shape: bow-rect, label: "REAL_USER" }
    EF_SV3@{ shape: bow-rect, label: "CTF_REPO_DIR" }
    EF_SV4@{ shape: bow-rect, label: "CTF_BASE" }
    EF_SV5@{ shape: bow-rect, label: "_CTF_BOX_DIRS[ ]" }
    EF_SV6@{ shape: bow-rect, label: "KNOWN_PLATFORMS[ ]" }
    EF_SV7@{ shape: bow-rect, label: "ADDRESS" }
    EF_SV8@{ shape: bow-rect, label: "PLATFORM" }
    EF_SV9@{ shape: bow-rect, label: "BOXNAME" }
    EF_SV10@{ shape: bow-rect, label: "BOX_DIR" }
    EF_SV11@{ shape: bow-rect, label: "_CTF_RED / _CTF_YELLOW / _CTF_GREEN" }
    EF_SV12@{ shape: bow-rect, label: "_CTF_CYAN / _CTF_BOLD / _CTF_DIM / _CTF_RESET" }

    %% --- Function-local variables: _ctf_persist() ---------------------------
    EF_H5_V1@{ shape: curv-trap, label: "tmp" }

    %% --- Function-local variables: _ctf_lookup_platform_name() -------------
