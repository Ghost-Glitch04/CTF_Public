    %% --- File nodes ----------------------------------------------------------
    F_CTF_ENV@{ shape: doc, label: "~/.ctf_env" }
    F_CTF_ENV_MODE@{ shape: doc, label: "~/.ctf_env_mode" }
    F_CTF_ENV_BACKUP@{ shape: doc, label: "~/.ctf_backups/.ctf_env.timestamp" }
    F_ZSHRC@{ shape: doc, label: "~/.zshrc" }
    F_BOX_ENV@{ shape: doc, label: "BOX_DIR/.env" }
    F_BOX_NOTES@{ shape: doc, label: "BOX_DIR/notes/notes.md" }
    F_EF_SRC@{ shape: doc, label: "setup/ctf-env-functions.sh" }
    F_SYMLINK@{ shape: flip-tri, label: "/usr/local/bin/ctf-*" }
    F_GITHUB@{ shape: lin-cyl, label: "github.com/Ghost-Glitch04/CTF_Public" }

    %% --- Environment / OS inputs (external sources) -------------------------
    ENV_SUDO_USER@{ shape: circle, label: "$SUDO_USER" }
    ENV_HOME@{ shape: circle, label: "$HOME" }
    ENV_USER@{ shape: circle, label: "$USER" }
    ENV_CTF_REPO_DIR@{ shape: circle, label: "$CTF_REPO_DIR (env override)" }
    ENV_CTF_BASE_DIR@{ shape: circle, label: "$CTF_BASE_DIR (env override)" }

    %% =========================================================================
    %% SHAPE GUIDELINES
    %% - Rectangles     (rect)         Scripts
    %% - Line-Rect      (lin-rect)     Functions
    %% - Flag           (flag)         Script flags / function arguments
    %% - Bow-Rect       (bow-rect)     Script-level variables
    %% - Curv-Trap      (curv-trap)    Function-local variables
    %% - Parallelogram  (lean-r)       Inputs / outputs
    %% - Cylinder       (cylinder)     Databases / storage
    %% - Hexagon        (hexagon)      Processes / operations
    %% - Diamond        (diamond)      Decision points
    %% - Circle         (circle)       Start points / external env inputs
    %% - Double Circle  (doublecircle) End points
    %% - Doc            (doc)          File names
    %% - Flip-Triangle  (flip-tri)     Symlinks
    %% - Lined Cylinder (lin-cyl)      GitHub Repo
    %% =========================================================================

    %% =========================================================================
    %% CONNECTION GUIDELINES
    %% - Solid Line      (-->)           Direct data flow / assignment
    %% - Dotted Line     (-. label .->)  Indirect / conditional flow
    %% - Thick Line      (==>)           Primary flow / main path
    %% - Write File      (--|WRITE|-->)  Writes to a file
    %% - Read File       (--|READ|-->)   Reads from a file
    %% =========================================================================

    %% =========================================================================
    %% SUBGRAPH — ctf-env-functions.sh
    %% =========================================================================
    subgraph ctf-env-functions.sh [ctf-env-functions.sh]

        subgraph EF_ScriptVars [Script-Level Variables]
